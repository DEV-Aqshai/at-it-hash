rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoom(data) {
      return data.roomId is string && data.roomId.size() >= 3 && data.roomId.size() <= 32 &&
             data.hostUid is string && data.hostUid.size() <= 128 &&
             data.hostName is string && data.hostName.size() <= 50 &&
             (!('guestUid' in data) || data.guestUid == null || (data.guestUid is string && data.guestUid.size() <= 128)) &&
             (!('guestName' in data) || data.guestName == null || (data.guestName is string && data.guestName.size() <= 50)) &&
             data.hasPasscode is bool &&
             (!('passcode' in data) || data.passcode == null || (data.passcode is string && data.passcode.size() <= 32)) &&
             data.status in ['waiting', 'playing', 'finished'] &&
             data.turn in ['@', '#'] &&
             data.phase in ['drop', 'move'] &&
             data.board is list && data.board.size() == 9 &&
             data.atPiecesPlaced is int && data.atPiecesPlaced >= 0 && data.atPiecesPlaced <= 3 &&
             data.hashPiecesPlaced is int && data.hashPiecesPlaced >= 0 && data.hashPiecesPlaced <= 3 &&
             data.winner in ['', '@', '#', 'draw'] &&
             data.winPattern is list && data.winPattern.size() <= 3 &&
             data.repeatMoveCount is int && data.repeatMoveCount >= 0 && data.repeatMoveCount <= 5 &&
             data.lastMoveFrom is int && data.lastMoveFrom >= -1 && data.lastMoveFrom <= 8 &&
             data.lastMoveTo is int && data.lastMoveTo >= -1 && data.lastMoveTo <= 8 &&
             data.lastMovePiece in ['', '@', '#'] &&
             data.rematchRequestedBy is list && data.rematchRequestedBy.size() <= 2 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 2 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) && (
        resource.data.status == 'waiting' ||
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid == resource.data.hostUid ||
        ('guestUid' in resource.data && request.auth.uid == resource.data.guestUid)
      );

      allow list: if isSignedIn() && (
        resource.data.status == 'waiting' ||
        request.auth.uid in resource.data.memberUids
      );

      allow create: if isSignedIn() &&
        isValidId(roomId) &&
        request.auth.uid == incoming().hostUid &&
        incoming().memberUids == [request.auth.uid] &&
        incoming().status == 'waiting' &&
        incoming().turn == '@' &&
        incoming().phase == 'drop' &&
        incoming().atPiecesPlaced == 0 &&
        incoming().hashPiecesPlaced == 0 &&
        incoming().repeatMoveCount == 0 &&
        incoming().winner == '' &&
        incoming().createdAt is timestamp &&
        isValidRoom(incoming());

      allow update: if isSignedIn() &&
        isValidId(roomId) &&
        isValidRoom(incoming()) &&
        incoming().hostUid == existing().hostUid &&
        incoming().createdAt == existing().createdAt &&
        (
          // Action 1: Guest joins room
          (
            existing().status == 'waiting' &&
            request.auth.uid != existing().hostUid &&
            incoming().guestUid == request.auth.uid &&
            incoming().status == 'playing' &&
            incoming().memberUids.hasAll([existing().hostUid, request.auth.uid]) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['guestUid', 'guestName', 'status', 'memberUids', 'updatedAt'])
          ) ||
          // Action 2: Player makes a move or turn update
          (
            existing().status == 'playing' &&
            request.auth.uid in existing().memberUids &&
            (
              (existing().turn == '@' && request.auth.uid == existing().hostUid) ||
              (existing().turn == '#' && request.auth.uid == existing().guestUid)
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'board', 'turn', 'phase', 'atPiecesPlaced', 'hashPiecesPlaced',
              'winner', 'winPattern', 'repeatMoveCount', 'lastMoveFrom',
              'lastMoveTo', 'lastMovePiece', 'status', 'updatedAt'
            ])
          ) ||
          // Action 3: Rematch request / reset game
          (
            existing().status == 'finished' &&
            request.auth.uid in existing().memberUids &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'board', 'turn', 'phase', 'atPiecesPlaced', 'hashPiecesPlaced',
              'winner', 'winPattern', 'repeatMoveCount', 'lastMoveFrom',
              'lastMoveTo', 'lastMovePiece', 'status', 'rematchRequestedBy', 'updatedAt'
            ])
          ) ||
          // Action 4: Leave room / forfeit
          (
            request.auth.uid in existing().memberUids &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'winner', 'updatedAt'])
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(roomId) &&
        request.auth.uid == existing().hostUid;
    }
  }
}
